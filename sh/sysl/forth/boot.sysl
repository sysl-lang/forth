module sh.sysl.forth
@no_alloc

// Making a machine: the stacks emptied, the dictionary region taken over and every built-in word
// defined in it.

// Set `vm` up over the dictionary region of `size` bytes at `lo`, talking through `con`. The region
// must outlive the machine; on a board it is module storage, like the machine itself.
boot(vm: *Vm, lo: usize, size: usize, con: *Console)
    vm.con = con
    vm.s0 = &vm.ds[2]
    vm.slim = &vm.ds[DS_CELLS - 1]
    vm.r0 = &vm.rs[0]
    vm.rlim = &vm.rs[RS_CELLS - 1]
    reset_stacks(vm)
    vm.error = 0
    vm.faults = 0
    vm.bye = false
    vm.abort_len = 0
    vm.missing_len = 0
    vm.state = 0
    vm.base = 10
    vm.to_in = 0
    vm.src = 0
    vm.src_len = 0
    vm.src_id = 0
    vm.lo = aligned(lo)
    vm.hi = lo + size
    vm.here = vm.lo
    vm.latest = 0
    vm.latest_xt = 0
    vm.def_start = 0
    vm.sidx = 0
    vm.subst = 0
    boot_ext(vm)
    boot_floating(vm)
    define_words(vm)
    vm.fence = vm.here

define_words(vm: *Vm)
    // The stacks.
    prim(vm, "DUP", &p_dup)
    prim(vm, "?DUP", &p_qdup)
    prim(vm, "DROP", &p_drop)
    prim(vm, "SWAP", &p_swap)
    prim(vm, "OVER", &p_over)
    prim(vm, "ROT", &p_rot)
    prim(vm, "NIP", &p_nip)
    prim(vm, "TUCK", &p_tuck)
    prim(vm, "2DUP", &p_2dup)
    prim(vm, "2DROP", &p_2drop)
    prim(vm, "2SWAP", &p_2swap)
    prim(vm, "2OVER", &p_2over)
    prim(vm, ">R", &p_tor)
    prim(vm, "R>", &p_rfrom)
    prim(vm, "R@", &p_rfetch)
    slow(vm, "DEPTH", &w_depth)
    slow(vm, "PICK", &w_pick)
    slow(vm, "ROLL", &w_roll)

    // Arithmetic and logic.
    prim(vm, "+", &p_plus)
    prim(vm, "-", &p_minus)
    prim(vm, "*", &p_star)
    prim(vm, "/", &p_slash)
    prim(vm, "MOD", &p_mod)
    prim(vm, "/MOD", &p_slashmod)
    prim(vm, "AND", &p_and)
    prim(vm, "OR", &p_or)
    prim(vm, "XOR", &p_xor)
    prim(vm, "INVERT", &p_invert)
    prim(vm, "NEGATE", &p_negate)
    prim(vm, "ABS", &p_abs)
    prim(vm, "1+", &p_1plus)
    prim(vm, "1-", &p_1minus)
    prim(vm, "2*", &p_2star)
    prim(vm, "2/", &p_2slash)
    prim(vm, "LSHIFT", &p_lshift)
    prim(vm, "RSHIFT", &p_rshift)
    prim(vm, "MIN", &p_min)
    prim(vm, "MAX", &p_max)
    prim(vm, "=", &p_eq)
    prim(vm, "<>", &p_ne)
    prim(vm, "<", &p_lt)
    prim(vm, ">", &p_gt)
    prim(vm, "U<", &p_ult)
    prim(vm, "U>", &p_ugt)
    prim(vm, "0=", &p_0eq)
    prim(vm, "0<>", &p_0ne)
    prim(vm, "0<", &p_0lt)
    prim(vm, "0>", &p_0gt)
    slow(vm, "S>D", &w_s_to_d)
    slow(vm, "M*", &w_mstar)
    slow(vm, "UM*", &w_umstar)
    slow(vm, "UM/MOD", &w_um_slash_mod)
    slow(vm, "SM/REM", &w_sm_slash_rem)
    slow(vm, "FM/MOD", &w_fm_slash_mod)
    slow(vm, "*/MOD", &w_star_slash_mod)
    slow(vm, "*/", &w_star_slash)
    constant(vm, "TRUE", -1)
    constant(vm, "FALSE", 0)
    constant(vm, "BL", 32)

    // Memory.
    prim(vm, "@", &p_fetch)
    prim(vm, "!", &p_store)
    prim(vm, "+!", &p_plusstore)
    prim(vm, "C@", &p_cfetch)
    prim(vm, "C!", &p_cstore)
    slow(vm, "2@", &w_2fetch)
    slow(vm, "2!", &w_2store)
    slow(vm, "HERE", &w_here)
    slow(vm, "ALLOT", &w_allot)
    slow(vm, ",", &w_comma)
    slow(vm, "C,", &w_ccomma)
    slow(vm, "ALIGN", &w_align)
    slow(vm, "ALIGNED", &w_aligned)
    slow(vm, "CELLS", &w_cells)
    slow(vm, "CELL+", &w_cellplus)
    slow(vm, "CHARS", &w_chars)
    prim(vm, "CHAR+", &p_1plus)
    slow(vm, "COUNT", &w_count)
    slow(vm, "FILL", &w_fill)
    slow(vm, "MOVE", &w_move)

    // Control flow. The run-time halves are primitives; the compiling halves are immediate.
    prim(vm, "EXIT", &p_exit)
    prim(vm, "EXECUTE", &p_execute)
    vm.xt_execute = vm.latest_xt
    prim(vm, "I", &p_i)
    prim(vm, "J", &p_j)
    prim(vm, "LEAVE", &p_leave)
    prim(vm, "UNLOOP", &p_unloop)
    slow(vm, "IF", &w_if)
    immediate(vm)
    slow(vm, "ELSE", &w_else)
    immediate(vm)
    slow(vm, "THEN", &w_then)
    immediate(vm)
    slow(vm, "BEGIN", &w_begin)
    immediate(vm)
    slow(vm, "UNTIL", &w_until)
    immediate(vm)
    slow(vm, "AGAIN", &w_again)
    immediate(vm)
    slow(vm, "WHILE", &w_while)
    immediate(vm)
    slow(vm, "REPEAT", &w_repeat)
    immediate(vm)
    slow(vm, "DO", &w_do)
    immediate(vm)
    slow(vm, "?DO", &w_qdo)
    immediate(vm)
    slow(vm, "LOOP", &w_loop)
    immediate(vm)
    slow(vm, "+LOOP", &w_ploop)
    immediate(vm)
    slow(vm, "RECURSE", &w_recurse)
    immediate(vm)

    // Defining words and the compiler.
    slow(vm, ":", &w_colon)
    slow(vm, ":NONAME", &w_noname)
    slow(vm, ";", &w_semicolon)
    immediate(vm)
    slow(vm, "CREATE", &w_create)
    slow(vm, "VARIABLE", &w_variable)
    slow(vm, "CONSTANT", &w_constant)
    slow(vm, "DOES>", &w_does)
    immediate(vm)
    slow(vm, "IMMEDIATE", &w_immediate)
    slow(vm, "'", &w_tick)
    slow(vm, "[']", &w_bracket_tick)
    immediate(vm)
    slow(vm, "[", &w_lbracket)
    immediate(vm)
    slow(vm, "]", &w_rbracket)
    slow(vm, "LITERAL", &w_literal)
    immediate(vm)
    slow(vm, "COMPILE,", &w_compile_comma)
    vm.xt_compile = vm.latest_xt
    slow(vm, "POSTPONE", &w_postpone)
    immediate(vm)
    slow(vm, ">BODY", &w_tobody)
    slow(vm, "STATE", &w_state)

    // The parser and interpreter.
    slow(vm, "WORD", &w_word)
    slow(vm, "PARSE", &w_parse)
    slow(vm, "PARSE-NAME", &w_parse_name)
    slow(vm, "FIND", &w_find)
    slow(vm, "EVALUATE", &w_evaluate)
    slow(vm, "SOURCE", &w_source)
    slow(vm, "SOURCE-ID", &w_source_id)
    slow(vm, "REFILL", &w_refill)
    slow(vm, ">IN", &w_to_in)
    slow(vm, ">NUMBER", &w_to_number)
    slow(vm, "BASE", &w_base)
    slow(vm, "DECIMAL", &w_decimal)
    slow(vm, "HEX", &w_hex)
    slow(vm, "(", &w_paren)
    immediate(vm)
    slow(vm, "\\", &w_backslash)
    immediate(vm)
    slow(vm, "CHAR", &w_char)
    slow(vm, "[CHAR]", &w_bracket_char)
    immediate(vm)
    slow(vm, "S\"", &w_squote)
    immediate(vm)
    slow(vm, ".\"", &w_dotquote)
    immediate(vm)
    slow(vm, ".(", &w_dotparen)
    immediate(vm)
    slow(vm, "ABORT\"", &w_abortquote)
    immediate(vm)

    // Output and input.
    slow(vm, "EMIT", &w_emit)
    slow(vm, "TYPE", &w_type)
    slow(vm, "CR", &w_cr)
    slow(vm, "SPACE", &w_space)
    slow(vm, "SPACES", &w_spaces)
    slow(vm, ".", &w_dot)
    slow(vm, "U.", &w_udot)
    slow(vm, ".S", &w_dots)
    slow(vm, "<#", &w_lesssharp)
    slow(vm, "#", &w_sharp)
    slow(vm, "#S", &w_sharps)
    slow(vm, "#>", &w_sharpgreater)
    slow(vm, "HOLD", &w_hold)
    slow(vm, "SIGN", &w_sign)
    slow(vm, "KEY", &w_key)
    slow(vm, "ACCEPT", &w_accept)
    slow(vm, "ENVIRONMENT?", &w_environmentq)
    slow(vm, "WORDS", &w_words)

    // Leaving.
    slow(vm, "ABORT", &w_abort)
    slow(vm, "QUIT", &w_quit)
    slow(vm, "BYE", &w_bye)

    // The Exception words.
    slow(vm, "CATCH", &w_catch)
    prim(vm, "THROW", &p_throw)

    // The String words, and 2VARIABLE from the Double-Number words.
    slow(vm, "COMPARE", &w_compare)
    slow(vm, "SEARCH", &w_search)
    slow(vm, "-TRAILING", &w_dash_trailing)
    slow(vm, "/STRING", &w_slash_string)
    slow(vm, "CMOVE", &w_cmove)
    slow(vm, "CMOVE>", &w_cmove_up)
    slow(vm, "BLANK", &w_blank)
    slow(vm, "SLITERAL", &w_sliteral)
    immediate(vm)
    slow(vm, "REPLACES", &w_replaces)
    slow(vm, "SUBSTITUTE", &w_substitute)
    slow(vm, "UNESCAPE", &w_unescape)
    slow(vm, "2VARIABLE", &w_2variable)

    // The Core Extension words not already above.
    prim(vm, "2>R", &p_2tor)
    prim(vm, "2R>", &p_2rfrom)
    prim(vm, "2R@", &p_2rfetch)
    prim(vm, "WITHIN", &p_within)
    slow(vm, "VALUE", &w_value)
    slow(vm, "TO", &w_to)
    immediate(vm)
    slow(vm, "DEFER", &w_defer)
    slow(vm, "IS", &w_to)
    immediate(vm)
    slow(vm, "DEFER@", &w_defer_fetch)
    slow(vm, "DEFER!", &w_defer_store)
    slow(vm, "ACTION-OF", &w_action_of)
    immediate(vm)
    slow(vm, "MARKER", &w_marker)
    slow(vm, "BUFFER:", &w_buffer_colon)
    slow(vm, "[COMPILE]", &w_bracket_compile)
    immediate(vm)
    slow(vm, "CASE", &w_case)
    immediate(vm)
    slow(vm, "OF", &w_of)
    immediate(vm)
    slow(vm, "ENDOF", &w_endof)
    immediate(vm)
    slow(vm, "ENDCASE", &w_endcase)
    immediate(vm)
    slow(vm, "C\"", &w_cquote)
    immediate(vm)
    slow(vm, "S\\\"", &w_sbackslashquote)
    immediate(vm)
    slow(vm, "PAD", &w_pad)
    slow(vm, "ERASE", &w_erase)
    slow(vm, "UNUSED", &w_unused)
    slow(vm, "SAVE-INPUT", &w_save_input)
    slow(vm, "RESTORE-INPUT", &w_restore_input)
    slow(vm, ".R", &w_dot_r)
    slow(vm, "U.R", &w_u_dot_r)
    slow(vm, "HOLDS", &w_holds)

    // The Programming-Tools words and their extensions not already above: `.S`, `WORDS`, `BYE` and
    // `STATE` are.
    slow(vm, "?", &w_question)
    slow(vm, "DUMP", &w_dump)
    slow(vm, "SEE", &w_see)
    slow(vm, "AHEAD", &w_ahead)
    immediate(vm)
    slow(vm, "CS-PICK", &w_pick)
    slow(vm, "CS-ROLL", &w_roll)
    slow(vm, "FORGET", &w_forget)
    slow(vm, "N>R", &w_n_to_r)
    slow(vm, "NR>", &w_n_r_from)
    slow(vm, "NAME>COMPILE", &w_name_to_compile)
    slow(vm, "NAME>INTERPRET", &w_name_to_interpret)
    slow(vm, "NAME>STRING", &w_name_to_string)
    slow(vm, "SYNONYM", &w_synonym)
    slow(vm, "TRAVERSE-WORDLIST", &w_traverse_wordlist)
    slow(vm, "[DEFINED]", &w_bracket_defined)
    immediate(vm)
    slow(vm, "[UNDEFINED]", &w_bracket_undefined)
    immediate(vm)
    slow(vm, "[IF]", &w_bracket_if)
    immediate(vm)
    slow(vm, "[ELSE]", &w_bracket_else)
    immediate(vm)
    slow(vm, "[THEN]", &w_bracket_then)
    immediate(vm)

    // The Floating-Point word set and its extensions. `DF@`, `DF!` and the other `DF` words are the
    // `F` ones, since a float is a double-precision one.
    slow(vm, ">FLOAT", &w_to_float)
    slow(vm, "D>F", &w_d_to_f)
    slow(vm, "F!", &w_fstore)
    slow(vm, "F*", &w_fstar)
    slow(vm, "F+", &w_fplus)
    slow(vm, "F-", &w_fminus)
    slow(vm, "F/", &w_fslash)
    slow(vm, "F0<", &w_fzero_less)
    slow(vm, "F0=", &w_fzero_equal)
    slow(vm, "F<", &w_fless)
    slow(vm, "F>D", &w_f_to_d)
    slow(vm, "F@", &w_ffetch)
    slow(vm, "FALIGN", &w_falign)
    slow(vm, "FALIGNED", &w_faligned)
    slow(vm, "FCONSTANT", &w_fconstant)
    slow(vm, "FDEPTH", &w_fdepth)
    slow(vm, "FDROP", &w_fdrop)
    slow(vm, "FDUP", &w_fdup)
    slow(vm, "FLITERAL", &w_fliteral)
    immediate(vm)
    slow(vm, "FLOAT+", &w_float_plus)
    slow(vm, "FLOATS", &w_floats)
    slow(vm, "FLOOR", &w_floor)
    slow(vm, "FMAX", &w_fmax)
    slow(vm, "FMIN", &w_fmin)
    slow(vm, "FNEGATE", &w_fnegate)
    slow(vm, "FOVER", &w_fover)
    slow(vm, "FROT", &w_frot)
    slow(vm, "FROUND", &w_fround)
    slow(vm, "FSWAP", &w_fswap)
    slow(vm, "FVARIABLE", &w_fvariable)
    slow(vm, "REPRESENT", &w_represent)

    slow(vm, "DF!", &w_fstore)
    slow(vm, "DF@", &w_ffetch)
    slow(vm, "DFALIGN", &w_falign)
    slow(vm, "DFALIGNED", &w_faligned)
    slow(vm, "DFFIELD:", &w_ffield)
    slow(vm, "DFLOAT+", &w_float_plus)
    slow(vm, "DFLOATS", &w_floats)
    slow(vm, "F**", &w_fstarstar)
    slow(vm, "F.", &w_fdot)
    slow(vm, "F>S", &w_f_to_s)
    slow(vm, "FABS", &w_fabs)
    slow(vm, "FACOS", &w_facos)
    slow(vm, "FACOSH", &w_facosh)
    slow(vm, "FALOG", &w_falog)
    slow(vm, "FASIN", &w_fasin)
    slow(vm, "FASINH", &w_fasinh)
    slow(vm, "FATAN", &w_fatan)
    slow(vm, "FATAN2", &w_fatan2)
    slow(vm, "FATANH", &w_fatanh)
    slow(vm, "FCOS", &w_fcos)
    slow(vm, "FCOSH", &w_fcosh)
    slow(vm, "FE.", &w_fedot)
    slow(vm, "FEXP", &w_fexp)
    slow(vm, "FEXPM1", &w_fexpm1)
    slow(vm, "FFIELD:", &w_ffield)
    slow(vm, "FLN", &w_fln)
    slow(vm, "FLNP1", &w_flnp1)
    slow(vm, "FLOG", &w_flog)
    slow(vm, "FS.", &w_fsdot)
    slow(vm, "FSIN", &w_fsin)
    slow(vm, "FSINCOS", &w_fsincos)
    slow(vm, "FSINH", &w_fsinh)
    slow(vm, "FSQRT", &w_fsqrt)
    slow(vm, "FTAN", &w_ftan)
    slow(vm, "FTANH", &w_ftanh)
    slow(vm, "FTRUNC", &w_ftrunc)
    slow(vm, "FVALUE", &w_fvalue)
    slow(vm, "F~", &w_fproximate)
    slow(vm, "PRECISION", &w_precision)
    slow(vm, "S>F", &w_s_to_f)
    slow(vm, "SET-PRECISION", &w_set_precision)
    slow(vm, "SF!", &w_sfstore)
    slow(vm, "SF@", &w_sffetch)
    slow(vm, "SFALIGN", &w_sfalign)
    slow(vm, "SFALIGNED", &w_sfaligned)
    slow(vm, "SFFIELD:", &w_sffield)
    slow(vm, "SFLOAT+", &w_sfloat_plus)
    slow(vm, "SFLOATS", &w_sfloats)
